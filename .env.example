# Credenciales de ejemplo. Copiar a .env y completar con los valores locales.
# .env NO debe versionarse.
DB_NAME=northwind
DB_USER=root
DB_PASS=
DB_HOST=localhost
DB_PORT=3306
PORT=3000

# Secreto para firmar los JWT: al menos 32 caracteres aleatorios.
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-32-caracteres-o-mas
# Duración de la sesión en segundos (43200 = 12 horas).
JWT_EXPIRES_IN_SECONDS=43200

# En producción, NODE_ENV=production activa la cookie Secure (requiere HTTPS).
NODE_ENV=development
